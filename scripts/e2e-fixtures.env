# Pinned E2E fixtures: the real llama.cpp build and the real GGUF model every
# PR runs the driver against.
#
# This file is the single source of truth for both
# scripts/provision-e2e-llamacpp.sh and the CI cache key. Changing any value
# here invalidates the cache, so a pin can never drift from the artifact
# actually restored.
#
# Every pin is an immutable revision plus a SHA-256. There is deliberately no
# "latest" fallback: an upstream retag must break the build loudly rather than
# silently change what the suite proved.

LLAMACPP_RELEASE=b9637
LLAMACPP_ASSET=llama-b9637-bin-ubuntu-x64.tar.gz
LLAMACPP_SHA256=a50ee14f021a9d8e92e30f622f7e3be1318ee1125bb9a9ba8d2025388df48743

MODEL_REPO=mradermacher/SmolLM2-135M-Instruct-GGUF
MODEL_REVISION=34d6b157ff9fb55285116fa8524deb0d90a4982e
MODEL_FILE=SmolLM2-135M-Instruct.Q4_K_M.gguf
MODEL_SHA256=ee1bbe2dd452b84feaf94a02150c04f10ba13f6840c389bab0f70f99c21ed02a
